{
  "name": "musicator-server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "pm2": "node ./node_modules/pm2/bin/pm2",
    "pm2:start": "node ./node_modules/pm2/bin/pm2 start src/index.ts --interpreter tsx",
    "pm2:stop": "node ./node_modules/pm2/bin/pm2 stop",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "create-user": "tsx src/scripts/create-user.ts",
    "get-users": "tsx src/scripts/get-users.ts",
    "drop-table": "tsx src/scripts/drop-table.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "^18.19.1",
    "npm": "^9.2.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.25.0",
    "drizzle-orm": "^0.34.1",
    "express": "^4.21.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "pm2": "^5.4.2"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^18.19.50",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.4.2"
  }
}
